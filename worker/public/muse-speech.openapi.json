{
  "openapi": "3.0.3",
  "info": {
    "title": "StackChan Muse Speech",
    "version": "1.0.0",
    "description": "Speak Muse replies verbatim through the always-on relay. Configure the existing APP_TOKEN privately as Bearer authentication."
  },
  "servers": [
    {
      "url": "https://<你的worker>.workers.dev"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/api/speak": {
      "post": {
        "operationId": "museSpeak",
        "summary": "Submit verbatim speech",
        "description": "Use a stable unique idempotency key for each reply and reuse it on retries. Same key and same text returns the same job; conflict or busy returns 409. Text must contain 1–1000 Unicode codepoints and not be whitespace-only. Only newline/tab Cc controls are allowed. JSON limit 16384 bytes; synthesized audio limit 120 seconds. Split long replies sequentially after settlement.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "text"
                ],
                "properties": {
                  "text": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1000,
                    "description": "Count Unicode codepoints, not UTF-16 code units; whitespace-only rejected."
                  },
                  "idempotency_key": {
                    "type": "string",
                    "nullable": true,
                    "minLength": 1,
                    "maxLength": 64,
                    "pattern": "^[A-Za-z0-9_-]+$"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Accepted job, not playback confirmation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SpeechJob"
                }
              }
            }
          },
          "400": {
            "description": "Request or relay error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Request or relay error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Request or relay error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "409": {
            "description": "Request or relay error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "413": {
            "description": "Request or relay error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "502": {
            "description": "Request or relay error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "503": {
            "description": "Request or relay error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/speak/{id}": {
      "get": {
        "operationId": "getMuseSpeech",
        "summary": "Poll speech job",
        "description": "Poll every 1–2 seconds until settled=true with done, failed or cancelled. done requires authenticated device completion.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[0-9a-f]{8}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Job snapshot",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SpeechJob"
                }
              }
            }
          },
          "400": {
            "description": "Request or relay error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Request or relay error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Request or relay error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "409": {
            "description": "Request or relay error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "413": {
            "description": "Request or relay error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "502": {
            "description": "Request or relay error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "503": {
            "description": "Request or relay error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/speak/{id}/cancel": {
      "post": {
        "operationId": "cancelMuseSpeech",
        "summary": "Cancel speech job",
        "description": "Request cancellation then poll until settled; inspect cancel_confirmed for device acknowledgement.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[0-9a-f]{8}$"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "maxProperties": 0
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Job snapshot",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SpeechJob"
                }
              }
            }
          },
          "400": {
            "description": "Request or relay error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Request or relay error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Request or relay error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "409": {
            "description": "Request or relay error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "413": {
            "description": "Request or relay error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "502": {
            "description": "Request or relay error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "503": {
            "description": "Request or relay error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Existing APP_TOKEN; never embed actual token in this schema."
      }
    },
    "schemas": {
      "SpeechJob": {
        "type": "object",
        "required": [
          "id",
          "status",
          "settled"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}$"
          },
          "status": {
            "type": "string",
            "enum": [
              "queued",
              "synthesizing",
              "playing",
              "done",
              "failed",
              "cancelled"
            ]
          },
          "error": {
            "type": "string"
          },
          "created_at": {
            "type": "number",
            "description": "Unix epoch seconds"
          },
          "settled": {
            "type": "boolean",
            "description": "Poll until true and terminal status; 202 alone does not confirm playback."
          },
          "cancel_confirmed": {
            "type": "boolean"
          },
          "frames": {
            "type": "integer",
            "minimum": 0
          },
          "audio_seconds": {
            "type": "number",
            "minimum": 0
          },
          "upload_seconds": {
            "type": "number",
            "minimum": 0
          }
        }
      }
    }
  }
}
